# Local binaries and artifacts
input/
output/
work/

# Allow exactly one release artifact in git
!output/
output/*
!output/messenger-550.0.0.45.63-spravaren-ultrabattery-v12-signed.apk

# Decompiled/app internals (never commit)
**/*.apk
**/*.apks
**/*.aab
**/*.idsig
**/*.keystore
**/*.jks

# Allow the single blessed APK above
!output/messenger-550.0.0.45.63-spravaren-ultrabattery-v12-signed.apk

# OS/editor
.vscode/
.DS_Store
Thumbs.db

# keep repo root clean (scratch logs/errs)
/*.log
logs/*.log
/*.err

# conversation exports (contain private data) - never commit
/20??-*-mozes-moj-*.txt
/20??-*.txt

# python cache
__pycache__/
